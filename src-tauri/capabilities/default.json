{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "popover"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-effects",
    "core:window:allow-theme",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://public-api.granola.ai/*" }]
    }
  ]
}
