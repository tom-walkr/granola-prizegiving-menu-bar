# Copy this to .env and fill in a real key. Get one from your Granola workspace settings.
VITE_GRANOLA_API_KEY=gr_your_api_key_here

# Set to "true" to run against the fixtures in src/mocks/notes.ts instead of the real API.
# Leave unset (or anything other than "true") to hit the real API — there's no automatic
# fallback to mock data if VITE_GRANOLA_API_KEY is missing or a request fails.
VITE_USE_MOCK_DATA=true