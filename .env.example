# Optional. Used only to seed Settings on first launch (and for Storybook).
# Prefer configuring the API key + mock toggle in the app: tray → Settings…
# or the gear icon in the popover.
VITE_GRANOLA_API_KEY=

# Storybook forces mock fixtures at build time. For the app, use Settings → Mock data.
VITE_USE_MOCK_DATA=true
